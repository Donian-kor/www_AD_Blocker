{
  "manifest_version": 3,
  "name": "www_AD_Blocker",
  "version": "0.37",
  "description": "PC 크롬에서 웹사이트 광고와 추적기를 차단하고 통계를 확인합니다.",
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestFeedback",
    "activeTab",
    "contextMenus",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.google.com/*",
    "*://*.googlesyndication.com/*",
    "*://*.doubleclick.net/*",
    "*://*.adsense.googlesyndication.com/*",
    "*://*.googleadservices.com/*",
    "*://*.google-analytics.com/*",
    "*://*.googletagmanager.com/*",
    "https://easylist.to/",
    "https://filters.adtidy.org/",
    "https://raw.githubusercontent.com/",
    "https://adblock.turtlecute.org/",
    "https://www.fanboy.co.nz/",
    "https://gitlab.com/",
    "https://pgl.yoyo.org/",
    "https://cdn.jsdelivr.net/"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "filters/static-index.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "noridev_1",
        "enabled": false,
        "path": "filters/ruleset_noridev.json"
      },
      {
        "id": "turtlecute_1",
        "enabled": false,
        "path": "filters/ruleset_turtlecute.json"
      },
      {
        "id": "d3host_1",
        "enabled": false,
        "path": "filters/ruleset_d3host.json"
      },
      {
        "id": "list-kr_1",
        "enabled": false,
        "path": "filters/ruleset_list-kr.json"
      },
      {
        "id": "filterslists-ko_1",
        "enabled": false,
        "path": "filters/ruleset_filterslists-ko.json"
      },
      {
        "id": "extra-hosts_1",
        "enabled": false,
        "path": "filters/ruleset_extra-hosts.json"
      },
      {
        "id": "anti-cv-en_1",
        "enabled": false,
        "path": "filters/ruleset_anti-cv-en.json"
      },
      {
        "id": "anti-cv-zh_1",
        "enabled": false,
        "path": "filters/ruleset_anti-cv-zh.json"
      },
      {
        "id": "anti-cv-cs_1",
        "enabled": false,
        "path": "filters/ruleset_anti-cv-cs.json"
      },
      {
        "id": "anti-cv-fr_1",
        "enabled": false,
        "path": "filters/ruleset_anti-cv-fr.json"
      },
      {
        "id": "anti-cv-de_1",
        "enabled": false,
        "path": "filters/ruleset_anti-cv-de.json"
      },
      {
        "id": "anti-cv-pl_1",
        "enabled": false,
        "path": "filters/ruleset_anti-cv-pl.json"
      },
      {
        "id": "anti-cv-ru_1",
        "enabled": false,
        "path": "filters/ruleset_anti-cv-ru.json"
      },
      {
        "id": "anti-cv-es_1",
        "enabled": false,
        "path": "filters/ruleset_anti-cv-es.json"
      },
      {
        "id": "fanboy-social_1",
        "enabled": false,
        "path": "filters/ruleset_fanboy-social.json"
      },
      {
        "id": "url-tracking_1",
        "enabled": false,
        "path": "filters/ruleset_url-tracking.json"
      },
      {
        "id": "uassets-privacy_1",
        "enabled": false,
        "path": "filters/ruleset_uassets-privacy.json"
      },
      {
        "id": "fanboy-annoyance_1",
        "enabled": false,
        "path": "filters/ruleset_fanboy-annoyance.json"
      },
      {
        "id": "nocoin_1",
        "enabled": false,
        "path": "filters/ruleset_nocoin.json"
      },
      {
        "id": "urlhaus_1",
        "enabled": false,
        "path": "filters/ruleset_urlhaus.json"
      },
      {
        "id": "urlhaus_2",
        "enabled": false,
        "path": "filters/ruleset_urlhaus_2.json"
      },
      {
        "id": "urlhaus_3",
        "enabled": false,
        "path": "filters/ruleset_urlhaus_3.json"
      },
      {
        "id": "urlhaus_4",
        "enabled": false,
        "path": "filters/ruleset_urlhaus_4.json"
      },
      {
        "id": "urlhaus_5",
        "enabled": false,
        "path": "filters/ruleset_urlhaus_5.json"
      },
      {
        "id": "uassets-badware_1",
        "enabled": false,
        "path": "filters/ruleset_uassets-badware.json"
      },
      {
        "id": "uassets-resource-abuse_1",
        "enabled": false,
        "path": "filters/ruleset_uassets-resource-abuse.json"
      },
      {
        "id": "uassets-filters_1",
        "enabled": false,
        "path": "filters/ruleset_uassets-filters.json"
      },
      {
        "id": "uassets-general_1",
        "enabled": false,
        "path": "filters/ruleset_uassets-general.json"
      },
      {
        "id": "uassets-2024_1",
        "enabled": false,
        "path": "filters/ruleset_uassets-2024.json"
      },
      {
        "id": "uassets-2025_1",
        "enabled": false,
        "path": "filters/ruleset_uassets-2025.json"
      },
      {
        "id": "uassets-2026_1",
        "enabled": false,
        "path": "filters/ruleset_uassets-2026.json"
      },
      {
        "id": "peter-lowe_1",
        "enabled": false,
        "path": "filters/ruleset_peter-lowe.json"
      },
      {
        "id": "easylist_1",
        "enabled": false,
        "path": "filters/ruleset_easylist.json"
      },
      {
        "id": "easylist_2",
        "enabled": false,
        "path": "filters/ruleset_easylist_2.json"
      },
      {
        "id": "easyprivacy_1",
        "enabled": false,
        "path": "filters/ruleset_easyprivacy.json"
      },
      {
        "id": "easyprivacy_2",
        "enabled": false,
        "path": "filters/ruleset_easyprivacy_2.json"
      },
      {
        "id": "ultimate_1",
        "enabled": false,
        "path": "filters/ruleset_ultimate.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared/allowlist.js",
        "anti-bypass.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared/allowlist.js",
        "shared/block-category.js",
        "general-blocker.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "shared/allowlist.js",
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://chzzk.naver.com/*"
      ],
      "js": [
        "chzzk-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "*://chzzk.naver.com/*"
      ],
      "js": [
        "shared/allowlist.js",
        "chzzk-ad-skip.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.gigafile.nu/*",
        "*://*.gofile.io/*",
        "*://*.gofile.to/*",
        "*://*.akirabox.com/*",
        "*://*.akirabox.to/*",
        "*://*.buzzheavier.com/*",
        "*://*.bzzhr.to/*"
      ],
      "js": [
        "shared/allowlist.js",
        "shared/block-category.js",
        "filehost-blocker.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.skidrowreloaded.com/*"
      ],
      "js": [
        "popunder-blocker.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared/block-category.js",
        "element-blocker.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "www_AD_Blocker",
    "default_icon": {
      "48": "icon48.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
